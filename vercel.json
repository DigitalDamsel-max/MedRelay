{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "functions": {
    "app.py": {
      "excludeFiles": "{.venv/**,env/**,venv/**,node_modules/**,*.db,*.sqlite,static/uploads/**}"
    }
  }
}
